# Provider: sarvam, bhashini, or none/local
LANGUAGE_PROVIDER=sarvam

# ---------------- Sarvam ----------------
SARVAM_API_KEY=
SARVAM_TRANSLATION_MODEL=sarvam-translate:v1
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TRANSLATION_MODE=formal
SARVAM_NUMERALS_FORMAT=international
SARVAM_TTS_SPEAKER=shubh
# Optional comma-separated STT keyterms, max 50 terms for Saaras v4
SARVAM_KEYTERMS=PAN,Aadhaar,RC,Driving Licence,marksheet,New Delhi

# ---------------- BHASHINI ----------------
BHASHINI_API_KEY=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_TRANSLATION_SERVICE_ID=
BHASHINI_ASR_SERVICE_ID=
BHASHINI_TTS_SERVICE_ID=
BHASHINI_LID_SERVICE_ID=
BHASHINI_TRANSLITERATION_SERVICE_ID=


# ---------------- DigiLocker Requester API (optional) ----------------
# A valid user OAuth access token is required to read already-issued documents.
# Client credentials are additionally required for issuer/document metadata discovery.
DIGILOCKER_ACCESS_TOKEN=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_BASE_URL=https://digilocker.meripehchaan.gov.in
DIGILOCKER_ISSUED_PATH=/public/oauth2/2/files/issued
DIGILOCKER_FILE_PATH=/public/oauth2/1/file/uri
DIGILOCKER_PULL_ISSUERS_PATH=/public/oauth2/1/pull/issuers
DIGILOCKER_PULL_DOCTYPE_PATH=/public/oauth2/1/pull/doctype
DIGILOCKER_PULL_PARAMETERS_PATH=/public/oauth2/1/pull/parameters
DIGILOCKER_PULL_DOCUMENT_PATH=/public/oauth2/1/pull/pulldocument

# ---------------- OCR ----------------
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Install only the Tesseract language packs you need.
# Recommended first set: eng+hin+mar+guj+tam+tel+kan+mal+ben+pan+ori+asm
OCR_LANGUAGES=eng+hin+mar+guj+tam+tel+kan+mal+ben+pan+ori+asm
OCR_DPI=220

# Application behavior
DEFAULT_UI_LANGUAGE=en-IN
LANGUAGE_CACHE_ENABLED=true
